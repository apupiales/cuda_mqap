# Visual Studio files keep Windows line endings on every checkout.
*.slnx     text eol=crlf
*.sln      text eol=crlf
*.vcxproj  text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.bat      text eol=crlf
*.ps1      text eol=crlf
.vsconfig  text eol=crlf

# Binary files (never converted or merged as text).
*.xlsx     binary
*.bin      binary
